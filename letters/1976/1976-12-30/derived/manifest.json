    {
      "page": 9,
      "source": "page-02.jpg",
      "rect": [
        140,
        1270,
        1435,
        1320
      ],
      "file": "sheet-09.webp",
      "reviewedBody": "Rubrik ungefär:\n\n> **Nu lite teckningar**\n\nFem figurer är numrerade.\nTexten under anger:\n1 = Suddgummi  \n2 = Utsuddat suddgummi  \n3 = en snöflinga  \n4 = en snöflinga  \n5 = en smält snöflinga",
      "transcriptionSha256": "503620dd240d9838cade89360d0b8380bdb51fdecf3ce86ecca11c13cc6e4529",
      "descriptionSha256": "0b493ba64353bee3a4a594099c99ed38adb62fc9f1d63102fc880bebba52045b",
      "sha256": "b1515057f66a1692a3ea8960cf3f36a4c8f6133e3de9ff44e6a21958a1f67381",
      "pngSha256": "33763a50e5319bf8b884038908a6869f748fc55ff480c68ada8507de2c6d56b1",
